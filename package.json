{
  "name": "pi-plan-tools",
  "version": "0.1.0",
  "description": "Plan management, execution, and permission enforcement for pi — save/submit plans, execute approved plans in clean sessions, cycle permission modes, and enforce ask/plan/auto-approve rules",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "plan",
    "planning",
    "permissions",
    "plan-mode",
    "ask-mode",
    "plannotator",
    "ai",
    "agents",
    "cli"
  ],
  "license": "MIT",
  "author": "javapacr",
  "repository": {
    "type": "git",
    "url": "https://github.com/javapacr/pi-plan-tools.git"
  },
  "pi": {
    "extensions": [
      "./plan-utils.ts",
      "./execute-plan.ts",
      "./permission-plan-mode.ts",
      "./plannotator-permissions-enhancer.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": ">=0.74.0",
    "@earendil-works/pi-ai": ">=0.74.0",
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-tui": ">=0.74.0",
    "typescript": "^5.0.0"
  }
}
